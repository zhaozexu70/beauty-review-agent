# Copy this file to .env and fill in your key. Never commit .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Price used ONLY for the cost estimate (CNY per 1M tokens, cache-miss price).
# Check the provider's official pricing page; these are assumptions.
LLM_PRICE_INPUT_PER_M=2
LLM_PRICE_OUTPUT_PER_M=3
LLM_PRICE_CURRENCY=CNY
